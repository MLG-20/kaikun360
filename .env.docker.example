# Variables d'environnement pour `docker compose --env-file .env.docker up`.
# Copier en `.env.docker` (ignoré par git) et remplir les valeurs vides.
# Différence avec backend/.env : ce fichier sert TOUS les services (mysql,
# redis, backend, scheduler, queue-worker) — il n'est jamais copié dans une
# image, seulement injecté en variables d'environnement des conteneurs.

# --- Port HTTP exposé par nginx sur la machine hôte ---
HTTP_PORT=80

# --- Application ---
APP_NAME=Kaikun360
APP_ENV=production
# `php artisan key:generate --show` en local, à coller ici (jamais générée
# dans le conteneur : elle doit survivre à une reconstruction de l'image).
APP_KEY=
APP_DEBUG=false
# Adresse vue par les visiteurs. En test VPS (avant le feu vert du client,
# voir la mémoire déploiement) : IP du serveur ou sous-domaine de test —
# JAMAIS kaikun360.com tant que la liste d'attente doit rester en ligne.
APP_URL=http://localhost
FRONTEND_URL=http://localhost
CORS_ALLOWED_ORIGINS=http://localhost
APP_LOCALE=fr
APP_FALLBACK_LOCALE=en

BRAND_SUPPORT_EMAIL=contact@kaikun360.com
BRAND_SUPPORT_PHONE="+221 33 000 00 00"
BRAND_ADDRESS="Dakar, Sénégal"

BCRYPT_ROUNDS=12
LOG_CHANNEL=stack
LOG_LEVEL=info

# --- Base de données (lue aussi par le service mysql) ---
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=kaikun360
DB_USERNAME=kaikun360
DB_PASSWORD=
DB_ROOT_PASSWORD=

# --- Cache / session / file d'attente (Redis obligatoire, cf. backend/.env.example) ---
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_DOMAIN=null
CACHE_STORE=redis
QUEUE_CONNECTION=redis
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=

FILESYSTEM_DISK=local

# --- E-mail transactionnel ---
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@kaikun360.com"
MAIL_FROM_NAME="${APP_NAME}"

# --- Assistant conversationnel (F10, hors CDC) ---
ASSISTANT_ENABLED=true
ASSISTANT_DRIVER=rules
ASSISTANT_RATE_PER_MINUTE=12
ANTHROPIC_API_KEY=
ASSISTANT_CLAUDE_MODEL=claude-haiku-4-5

# --- SMS ---
SMS_PROVIDER=log
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=

# --- PayTech (B14) ---
PAYTECH_BASE_URL=https://paytech.sn/api
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test
PAYTECH_IPN_URL=
PAYTECH_SUCCESS_URL=
PAYTECH_CANCEL_URL=

# --- Connexion Google (B19) ---
GOOGLE_CLIENT_ID=

# --- Webhooks sortants n8n (B18) ---
N8N_WEBHOOK_ENABLED=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# --- Comptes back-office de démonstration ---
BACKOFFICE_DEMO_SUPER_EMAIL=
BACKOFFICE_DEMO_AGENT_EMAIL=
