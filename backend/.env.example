APP_NAME=Kaikun360
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

# URL PUBLIQUE DU SITE (Angular) : sert à construire les liens des e-mails.
FRONTEND_URL=http://localhost:4200

# Coordonnées affichées en pied des e-mails transactionnels.
BRAND_SUPPORT_EMAIL=contact@kaikun360.com
BRAND_SUPPORT_PHONE="+221 33 000 00 00"
BRAND_ADDRESS="Dakar, Sénégal"

# Origines autorisées à appeler l'API (CORS), séparées par des virgules.
# En dev : le serveur Angular (port 4200). En prod : les domaines Kaikun officiels.
CORS_ALLOWED_ORIGINS="http://localhost:4200,http://127.0.0.1:4200"

APP_LOCALE=fr
# ⚠️ Le REPLI doit rester `en`, jamais `fr`. Laravel embarque ses traductions
# anglaises : une clé absente de `lang/fr` retombe alors sur une phrase anglaise
# LISIBLE. Avec `fr` en repli, la même clé ressort BRUTE — c'est ce qui faisait
# répondre « validation.required » à de vrais visiteurs sur POST /contact.
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kaikun360
DB_USERNAME=
DB_PASSWORD=

SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# --- Kaikun 360 : intégrations externes ---

# CORS : origines autorisées du frontend (séparées par des virgules)
CORS_ALLOWED_ORIGINS=

# SMS (B16/B18) : `log` (dev, écrit dans les logs), `twilio` ou `orange`
SMS_PROVIDER=log
# Codes de vérification destinés au TÉLÉPHONE : les envoyer par e-mail plutôt
# que par SMS. Par défaut actif quand SMS_PROVIDER=log (le SMS n'arriverait
# nulle part), levé dès qu'un fournisseur réel est configuré. Ne renseigner
# cette ligne que pour forcer l'un ou l'autre comportement.
# SMS_VERIFICATION_VIA_MAIL=true
TWILIO_SID=
TWILIO_TOKEN=
TWILIO_FROM=
# Orange / Sonatel (B18.2) — identifiants via developer.orange.com (SMS API)
ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=
ORANGE_SMS_BASE_URL=https://api.orange.com
ORANGE_SMS_TOKEN_URL=https://api.orange.com/oauth/v3/token
ORANGE_SMS_SENDER_ADDRESS=
ORANGE_SMS_SENDER_NAME=KAIKUN360

# Paiement PayTech (B14) : sandbox puis production
# PayTech — sandbox et production partagent la même base, c'est PAYTECH_ENV qui
# décide. En mode test, PayTech ne débite qu'un montant aléatoire (100-150 FCFA).
PAYTECH_BASE_URL=https://paytech.sn/api
PAYTECH_API_KEY=
PAYTECH_API_SECRET=
PAYTECH_ENV=test
# URL PUBLIQUE et HTTPS de POST /api/v1/payments/webhook. En local, ouvrir un
# tunnel (ngrok http 8000) et reporter l'URL ici ET dans le tableau de bord PayTech.
PAYTECH_IPN_URL=
PAYTECH_SUCCESS_URL=
PAYTECH_CANCEL_URL=

# Webhooks sortants vers n8n (B18) — voir WEBHOOKS.md
N8N_WEBHOOK_ENABLED=false
N8N_WEBHOOK_URL=
N8N_WEBHOOK_SECRET=

# Connexion Google (B19) — Client ID OAuth (Google Cloud Console)
GOOGLE_CLIENT_ID=

# Comptes back-office de démonstration (BackOfficeDemoSeeder).
# ⚠️ Les pointer vers de VRAIES boîtes en local : toute alerte interne (demande
# à traiter, bien à valider…) part vers TOUS les comptes de l'équipe. Laissés
# sur un domaine inexistant, ils font rebondir chaque alerte, et les rapports
# d'échec retombent dans la boîte d'expédition (MAIL_FROM_ADDRESS).
# Astuce Gmail : les sous-adresses `moi+bo.agent@gmail.com` arrivent toutes dans
# la même boîte tout en restant des comptes distincts pour l'application.
BACKOFFICE_DEMO_SUPER_EMAIL=
BACKOFFICE_DEMO_AGENT_EMAIL=
